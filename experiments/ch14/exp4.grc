    affinity: ''
    alias: ''
    amplitude: '1'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    sensitivity: 2*pi
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 176.0]
    rotation: 0
    state: enabled
