- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='4-PAM Hard Decision',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.uint8]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        y = output_items[0]\n\n\
      \        n = min(len(x), len(y))\n\n        for i in range(n):\n           \
      \ if x[i] < -2:\n                y[i] = 0\n            elif x[i] < 0:\n    \
      \            y[i] = 1\n            elif x[i] < 2:\n                y[i] = 2\n\
      \            else:\n                y[i] = 3\n\n        return n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('4-PAM Hard Decision', 'blk', [], [('0', 'float', 1)], [('0', 'byte',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 504.0]
    rotation: 0
    state: enabled
