connections:
- [analog_const_source_x_0, '0', blocks_add_xx_0, '1']
- [analog_const_source_x_1, '0', qtgui_number_sink_1, '0']
- [analog_const_source_x_1_0, '0', qtgui_number_sink_1, '1']
- [analog_const_source_x_1_0_0, '0', qtgui_number_sink_1, '3']
